# Copy to .env and fill in. Never commit .env.
# Values here are safe defaults for local development with `make dev` / `make services`.

# --- Django ---------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.dev
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Where links in emails/SMS point, and the GitHub OAuth redirect base.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Shown by /api/v1/health. Set by CI / the host at deploy time.
APP_VERSION=0.1.0
GIT_COMMIT_SHA=

# --- Database / cache / queue ---------------------------------------------
DATABASE_URL=postgres://skillproof:skillproof@localhost:5433/skillproof
REDIS_URL=redis://localhost:6379/0
# true = Celery tasks run inline in the web process (no worker needed locally).
CELERY_TASK_ALWAYS_EAGER=true

# --- Auth -----------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Analysis -------------------------------------------------------------
GITHUB_TOKEN=
ANALYSIS_CACHE_HOURS=24
ANALYSIS_MAX_REPOS=15
ANALYSIS_COMMIT_SAMPLE=20
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# --- Email (Mailpit locally: SMTP 1025, UI http://localhost:8025) -----------
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=SkillProof <no-reply@skillproof.app>

# --- Thrivewave SMS (dry run until the organisers share the API docs) -----
SMS_DRY_RUN=true
THRIVEWAVE_BASE_URL=
THRIVEWAVE_API_KEY=
THRIVEWAVE_USERNAME=
THRIVEWAVE_SENDER_ID=
THRIVEWAVE_SMS_PATH=/sms/send
THRIVEWAVE_WEBHOOK_SECRET=

# --- Observability --------------------------------------------------------
# json (default, for log aggregation) or text (easier to read in a terminal)
LOG_FORMAT=json
LOG_LEVEL=INFO
SENTRY_DSN=
